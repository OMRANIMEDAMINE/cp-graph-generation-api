<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>edu.polytech</groupId>
    <artifactId>CP-Molgen-API</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>CP-Molgen-API</name>
    <description>CP-Molgen-API</description>
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ilog</groupId>
            <artifactId>cplex</artifactId>
            <version>22.1.1</version>
            <scope>system</scope>
            <systemPath>/opt/ibm/ILOG/CPLEX_Studio_Community2211/cplex/lib/cplex.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>ilog</groupId>
            <artifactId>opl</artifactId>
            <version>22.1.1</version>
            <scope>system</scope>
            <systemPath>/opt/ibm/ILOG/CPLEX_Studio_Community2211/opl/lib/oplall.jar</systemPath>
        </dependency>
        <!-- JGraphT Dependency -->
        <dependency>
            <groupId>org.graphstream</groupId>
            <artifactId>gs-core</artifactId>
            <version>2.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.jgrapht/jgrapht-core -->
        <dependency>
            <groupId>org.jgrapht</groupId>
            <artifactId>jgrapht-core</artifactId>
            <version>1.5.2</version>
        </dependency>



         <dependency>
          <groupId>org.jfree</groupId>
           <artifactId>jfreechart</artifactId>
           <version>1.5.4</version>
         </dependency>
          <dependency>
           <groupId>org.jfree</groupId>
           <artifactId>jcommon</artifactId>
           <version>1.0.24</version> <!-- optional in some setups; keep if your build complains -->
         </dependency>


    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
        </plugins>
    </build>

</project>
